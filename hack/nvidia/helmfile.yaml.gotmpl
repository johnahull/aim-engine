---
# NVIDIA-specific Kubernetes dependencies.
#
# The host driver, NVIDIA container toolkit/runtime, and RuntimeClass must
# already exist. This installs only the Kubernetes device plugin and its
# bundled Node Feature Discovery deployment.
repositories:
  - name: nvidia-device-plugin
    url: https://nvidia.github.io/k8s-device-plugin

releases:
  - name: nvidia-device-plugin
    namespace: nvidia-device-plugin
    chart: nvidia-device-plugin/nvidia-device-plugin
    version: {{ env "NVIDIA_DEVICE_PLUGIN_VERSION" | default "0.19.3" | quote }}
    createNamespace: true
    wait: true
    timeout: 600
    values:
      - values.yaml
